# AXES
axes.titlesize : 24
axes.labelsize : 20
axes.edgecolor: 0.3333, 0.3333, 0.3255, 1.0
axes.facecolor: 0.9725, 0.9686, 0.9529, 1.0
axes.prop_cycle : cycler('color', ['2b326d', 'fbb348', '8423ff', '8089bf', '71716f', 'd6ee3f'])

# TICKS
xtick.labelsize : 16
ytick.labelsize : 16



# GRID
axes.grid : True
grid.alpha : 0.7
grid.linestyle : --
grid.linewidth : 0.6

# LINES
lines.linewidth : 3
lines.color : 0.9843, 0.7019, 0.2823, 1.0
lines.markerfacecolor : 0.9843, 0.7019, 0.2823, 1.0
lines.markersize : 20

# FIGURE OUTPUT 
figure.figsize  : 7, 5
figure.dpi : 150
savefig.dpi : 200
figure.edgecolor: 0.3333, 0.3333, 0.3255, 1.0
figure.facecolor: 0.9725, 0.9686, 0.9529, 1.0

# SCATTER PLOT
scatter.marker : .